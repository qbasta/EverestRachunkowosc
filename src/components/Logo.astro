---
import { Image } from 'astro:assets';
import light from '../assets/brand/logo-light.svg';
import dark from '../assets/brand/logo-dark.svg';

interface Props {
  /** `light` = białe logo (na ciemne tło), `dark` = granatowe (na jasne tło). */
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'light', class: className } = Astro.props;
const src = variant === 'light' ? light : dark;
---

<Image
  src={src}
  alt="Everest – Biuro rachunkowe & NGO"
  width={135}
  height={48}
  class:list={['w-auto', className ?? 'h-12']}
  loading="eager"
  decoding="async"
/>
