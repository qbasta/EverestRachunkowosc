---
import type { Lang } from '../i18n';
import { getDict } from '../i18n';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Info from './Info.astro';
import Cooperation from './Cooperation.astro';
import AboutTeaser from './AboutTeaser.astro';
import Contact from './Contact.astro';
import Trust from './Trust.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
---

<Header t={t} lang={lang} page="home" />
<main id="main">
  <Hero t={t} lang={lang} />
  <Services t={t} />
  <Info t={t} />
  <Cooperation t={t} />
  <AboutTeaser t={t} lang={lang} />
  <Contact t={t} lang={lang} />
  <Trust t={t} />
</main>
<Footer t={t} lang={lang} />
