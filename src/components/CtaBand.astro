---
import { homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
---

<section aria-labelledby="cta-title" class="section-y bg-summit text-white">
  <div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <div>
      <h2 id="cta-title" class="text-h3">
        {t.contact.title}
      </h2>
      <p class="mt-3 max-w-[44ch] text-white/85">{t.contact.intro}</p>
    </div>
    <a href={`${homePath(lang)}#contact`} class="btn btn-light shrink-0">
      {t.nav.contact}
    </a>
  </div>
</section>
