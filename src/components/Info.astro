---
import AppWindow from '@lucide/astro/icons/app-window';
import Receipt from '@lucide/astro/icons/receipt';
import Landmark from '@lucide/astro/icons/landmark';
import Files from '@lucide/astro/icons/files';
import Users from '@lucide/astro/icons/users';
import ListChecks from '@lucide/astro/icons/list-checks';
import { Image } from 'astro:assets';
import { softwareBrands } from '../config/software';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

// Ikony czynników wyceny – kolejność jak w słowniku
// (specyfika organizacji, liczba dokumentów, liczba zatrudnionych, zakres obowiązków).
const factorIcons = [Landmark, Files, Users, ListChecks];
const brandByKey = new Map(softwareBrands.map((b) => [b.key, b]));
---

<section id="info" aria-labelledby="info-title" class="section-y bg-summit text-white">
  <div class="container-page">
    <h2 id="info-title" class="text-h2">
      {t.info.title}
    </h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <span class="bg-glacier inline-flex h-16 w-16 items-center justify-center rounded text-white">
          <AppWindow class="size-8" stroke-width={1.75} aria-hidden="true" />
        </span>
        <h3 class="mt-4 text-2xl font-semibold">{t.info.software.title}</h3>
        <p class="mt-3 max-w-[52ch] text-white/85">{t.info.software.text}</p>

        <ul class="mt-6">
          {t.info.software.items.map((item) => {
            const brand = brandByKey.get(item.key);
            return (
              <li class="flex flex-col items-start gap-4 border-t border-white/25 py-6 last:border-b sm:flex-row sm:items-center sm:gap-6">
                <span class="flex h-[4.5rem] w-full max-w-[14rem] shrink-0 items-center justify-center rounded bg-white px-5 sm:w-56">
                  {brand?.logo ? (
                    <Image
                      src={brand.logo}
                      alt={brand.name}
                      class="max-h-11 w-auto max-w-full object-contain"
                    />
                  ) : (
                    <span class="text-summit text-center text-base leading-tight font-bold">
                      {brand?.name ?? item.key}
                    </span>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block text-lg font-semibold">{item.role}</span>
                  <span class="mt-0.5 block text-base text-white/80">{item.description}</span>
                </span>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <span class="bg-glacier inline-flex h-16 w-16 items-center justify-center rounded text-white">
          <Receipt class="size-8" stroke-width={1.75} aria-hidden="true" />
        </span>
        <h3 class="mt-4 text-2xl font-semibold">{t.info.pricing.title}</h3>
        <p class="mt-3 max-w-[52ch] text-white/85">{t.info.pricing.text}</p>
        <ul class="factor-list mt-6">
          {t.info.pricing.items.map((item, i) => {
            const Icon = factorIcons[i] ?? ListChecks;
            return (
              <li>
                <Icon
                  class="size-[1.65rem] shrink-0 text-white/80"
                  stroke-width={1.75}
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .factor-list {
    list-style: none;
  }
  .factor-list li {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-height: 4.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.25);
    font-size: 1rem;
  }
  .factor-list li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
  }
</style>
