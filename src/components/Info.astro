---
import AppWindow from '@lucide/astro/icons/app-window';
import Receipt from '@lucide/astro/icons/receipt';
import Landmark from '@lucide/astro/icons/landmark';
import Files from '@lucide/astro/icons/files';
import Users from '@lucide/astro/icons/users';
import ListChecks from '@lucide/astro/icons/list-checks';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

// Ikony czynników wyceny – kolejność jak w słowniku
// (specyfika organizacji, liczba dokumentów, liczba zatrudnionych, zakres obowiązków).
const factorIcons = [Landmark, Files, Users, ListChecks];
---

<section id="info" aria-labelledby="info-title" class="section-y bg-summit text-white">
  <div class="container-page">
    <h2 id="info-title" class="text-4xl font-bold md:text-5xl">
      {t.info.title}
    </h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-[52ch]">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-white/10 text-white">
          <AppWindow size={30} stroke-width={1.75} aria-hidden="true" />
        </span>
        <h3 class="mt-4 text-2xl font-semibold">{t.info.software.title}</h3>
        <p class="mt-4 text-white/85">{t.info.software.text}</p>
      </div>

      <div class="max-w-[52ch]">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-white/10 text-white">
          <Receipt size={30} stroke-width={1.75} aria-hidden="true" />
        </span>
        <h3 class="mt-4 text-2xl font-semibold">{t.info.pricing.title}</h3>
        <p class="mt-4 text-white/85">{t.info.pricing.text}</p>
        <ul class="mt-4 divide-y divide-white/20 border-y border-white/20">
          {t.info.pricing.items.map((item, i) => {
            const Icon = factorIcons[i] ?? ListChecks;
            return (
              <li class="flex items-start gap-3 py-3 text-base">
                <Icon
                  size={20}
                  stroke-width={1.75}
                  class="mt-0.5 shrink-0 text-white/70"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>
