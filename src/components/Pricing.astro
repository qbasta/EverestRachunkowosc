---
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import FilePlus from '@lucide/astro/icons/file-plus';
import { pagePath, homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
const p = t.pricing;
// Ikony akapitów opisu, w kolejności ze słownika: co wpływa na wycenę, usługi dodatkowe.
const icons = [ClipboardList, FilePlus];
---

<section id="pricing" aria-labelledby="pricing-title" class="section-y bg-ice">
  <div class="container-page">
    <h2 id="pricing-title" class="text-summit text-h2">
      {p.title}
    </h2>

    <!-- Opis i cennik zaczynają się i kończą na tej samej wysokości (kolumny rozciągnięte). -->
    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Każdy akapit opisu w osobnym polu z ikoną – zamiast jednej ściany tekstu. -->
      <div class="flex flex-col gap-5 lg:col-span-6">
        {p.paragraphs.map((text, i) => {
          const Icon = icons[i] ?? ClipboardList;
          return (
            <div class="note">
              <span class="bg-summit inline-flex h-11 w-11 shrink-0 items-center justify-center rounded text-white">
                <Icon class="size-5" stroke-width={1.9} aria-hidden="true" />
              </span>
              <p class="text-ink/85 leading-[1.7]">{text}</p>
            </div>
          );
        })}
      </div>

      <div class="lg:col-span-6">
        <!-- Cennik jako osobna karta: nazwa usługi, kropkowana linia (jak w spisie treści) i cena. -->
        <div class="price-card">
          <h3 class="text-summit text-h3">{p.priceList.title}</h3>
          <p class="text-slate mt-2">{p.priceList.intro}</p>
          <ul class="price-list">
            {p.priceList.items.map((item) => (
              <li class="price-row">
                <span class="text-ink">{item.label}</span>
                <span class="price-leader" aria-hidden="true" />
                <span class="price-value">{item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="bg-summit mt-14 flex flex-col gap-8 rounded p-8 text-white md:flex-row md:items-center md:justify-between md:p-10 lg:mt-16">
      <p class="max-w-[52ch] text-xl leading-snug">{p.closing}</p>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href={pagePath('quote', lang)} class="btn btn-light">
          {p.cta}
        </a>
        <a href={`${homePath(lang)}#contact`} class="btn btn-ghost">
          {p.ctaConsult}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .note {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--color-mist);
    border-radius: 0.25rem;
    background: rgb(255 255 255 / 0.6);
    padding: 1.5rem;
  }
  /* Pierwsze pole (dłuższy akapit) zabiera resztę wysokości, żeby dół opisu równał się z dołem cennika. */
  .note:first-child {
    flex: 1 1 auto;
  }
  @media (min-width: 40rem) {
    .note {
      flex-direction: row;
      gap: 1.25rem;
      padding: 1.75rem;
    }
  }
  .price-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    border: 1px solid var(--color-mist);
    border-top: 3px solid var(--color-summit);
    border-radius: 0 0 0.25rem 0.25rem;
    background: #fff;
    padding: 1.75rem 1.5rem 1rem;
  }
  /* Wiersze rozkładają się równo na całą wysokość karty. */
  .price-list {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    margin-top: 1.5rem;
  }
  .price-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-mist);
  }
  .price-leader {
    display: none;
  }
  .price-value {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-summit);
  }
  @media (min-width: 40rem) {
    .price-card {
      padding: 2.25rem 2.25rem 1.25rem;
    }
    /* Każdy wiersz dostaje równą część wysokości karty; treść wiersza jest wyśrodkowana w pionie. */
    .price-row {
      flex: 1 1 auto;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding-block: 1.15rem;
    }
    .price-leader {
      display: block;
      flex: 1 1 0.75rem;
      min-width: 0.75rem;
      border-bottom: 2px dotted color-mix(in srgb, var(--color-slate) 55%, transparent);
    }
    .price-value {
      flex-shrink: 0;
      text-align: right;
      white-space: nowrap;
    }
  }
</style>
