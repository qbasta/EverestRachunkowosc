---
import { pagePath, homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
const p = t.pricing;
---

<section id="pricing" aria-labelledby="pricing-title" class="section-y bg-ice">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <h2 id="pricing-title" class="text-summit text-h2">
          {p.title}
        </h2>
        <div class="text-ink/85 mt-6 max-w-[62ch] space-y-5">
          {p.paragraphs.map((text) => (
            <p>{text}</p>
          ))}
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="border-summit border-t-[3px] pt-6">
          <h3 class="text-summit text-h3">{p.priceList.title}</h3>
          <p class="text-slate mt-2">{p.priceList.intro}</p>
          <ul class="mt-4">
            {p.priceList.items.map((item) => (
              <li class="border-mist grid items-baseline gap-x-6 gap-y-1 border-b py-4 sm:grid-cols-[minmax(0,1fr)_auto]">
                <span class="text-ink">{item.label}</span>
                <span class="text-summit font-semibold sm:text-right">{item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="border-mist mt-14 flex flex-col gap-8 border-t pt-10 md:flex-row md:items-center md:justify-between">
      <p class="text-ink max-w-[52ch] text-xl leading-snug md:text-2xl">{p.closing}</p>
      <div class="flex flex-wrap gap-3">
        <a href={pagePath('quote', lang)} class="btn btn-primary">
          {p.cta}
        </a>
        <a href={`${homePath(lang)}#contact`} class="btn btn-outline">
          {p.ctaConsult}
        </a>
      </div>
    </div>
  </div>
</section>
