---
import { pagePath, homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
const p = t.pricing;
---

<section id="pricing" aria-labelledby="pricing-title" class="section-y bg-ice">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <h2 id="pricing-title" class="text-summit text-h2">
          {p.title}
        </h2>
        <div class="text-ink/85 mt-6 max-w-[62ch] space-y-5 leading-[1.75]">
          {p.paragraphs.map((text) => (
            <p>{text}</p>
          ))}
        </div>
      </div>

      <div class="lg:col-span-7">
        <!-- Cennik jako osobna karta: nazwa usługi, kropkowana linia (jak w spisie treści) i cena. -->
        <div class="price-card">
          <h3 class="text-summit text-h3">{p.priceList.title}</h3>
          <p class="text-slate mt-2">{p.priceList.intro}</p>
          <ul class="mt-6">
            {p.priceList.items.map((item) => (
              <li class="price-row">
                <span class="text-ink">{item.label}</span>
                <span class="price-leader" aria-hidden="true" />
                <span class="price-value">{item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="bg-summit mt-14 flex flex-col gap-8 rounded p-8 text-white md:flex-row md:items-center md:justify-between md:p-10 lg:mt-16">
      <p class="max-w-[52ch] text-xl leading-snug">{p.closing}</p>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href={pagePath('quote', lang)} class="btn btn-light">
          {p.cta}
        </a>
        <a href={`${homePath(lang)}#contact`} class="btn btn-ghost">
          {p.ctaConsult}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .price-card {
    border: 1px solid var(--color-mist);
    border-top: 3px solid var(--color-summit);
    border-radius: 0 0 0.25rem 0.25rem;
    background: #fff;
    padding: 1.75rem 1.5rem 1rem;
  }
  .price-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-mist);
  }
  .price-leader {
    display: none;
  }
  .price-value {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-summit);
  }
  @media (min-width: 40rem) {
    .price-card {
      padding: 2.25rem 2.25rem 1.25rem;
    }
    .price-row {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
      padding-block: 1.15rem;
    }
    .price-leader {
      display: block;
      flex: 1 1 0.75rem;
      min-width: 0.75rem;
      border-bottom: 2px dotted color-mix(in srgb, var(--color-slate) 55%, transparent);
      transform: translateY(-0.25em);
    }
    .price-value {
      flex-shrink: 0;
      text-align: right;
      white-space: nowrap;
    }
  }
</style>
