---
import type { Dict } from '../i18n/pl';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const [lead, ...rest] = t.about.paragraphs;
---

<section id="about" aria-labelledby="about-title" class="section-y">
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <h2 id="about-title" class="text-summit text-4xl font-bold md:text-5xl lg:col-span-5">
      {t.about.title}
    </h2>
    <div class="max-w-[62ch] space-y-6 lg:col-span-7">
      <p class="text-ink text-xl leading-snug md:text-2xl">{lead}</p>
      {rest.map((p) => (
        <p class="text-slate">{p}</p>
      ))}
    </div>
  </div>
</section>
