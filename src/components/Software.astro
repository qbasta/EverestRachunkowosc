---
import MonitorCog from '@lucide/astro/icons/monitor-cog';
import { Image } from 'astro:assets';
import { softwareBrands } from '../config/software';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section id="software" aria-labelledby="software-title" class="section-y bg-summit text-white">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <!-- Ikona w kaflu, jak przy grupach usług (tu w odwróconych kolorach, bo tło jest granatowe). -->
      <span class="text-summit inline-flex h-16 w-16 items-center justify-center rounded bg-white">
        <MonitorCog class="size-8" stroke-width={1.75} aria-hidden="true" />
      </span>
      <h2 id="software-title" class="text-h2 mt-6">
        {t.software.title}
      </h2>
      <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-white/85">{t.software.text}</p>
    </div>

    <!-- Cztery programy w układzie 2×2; pod logo etykieta, do czego program służy. -->
    <ul class="grid grid-cols-2 content-start gap-x-6 gap-y-10 lg:col-span-7">
      {softwareBrands.map((brand) => (
        <li class="flex flex-col">
          <span class="flex h-28 items-center justify-center rounded bg-white px-6">
            {brand.logo ? (
              <Image
                src={brand.logo}
                alt={brand.name}
                class="max-h-12 w-auto max-w-full object-contain"
              />
            ) : (
              // Brak pliku logo – nazwa programu złożona czcionką nagłówków.
              <span class="font-display text-summit text-2xl font-semibold" aria-hidden="true">
                {brand.short ?? brand.name}
              </span>
            )}
          </span>
          <span class="mt-4 text-xs font-semibold tracking-[0.08em] text-white/65 uppercase">
            {t.software.categories[brand.category]}
          </span>
          <span class="mt-1 text-base leading-snug font-medium text-white/95">{brand.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
