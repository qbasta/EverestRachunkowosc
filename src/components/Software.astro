---
import { Image } from 'astro:assets';
import { softwareBrands } from '../config/software';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section id="software" aria-labelledby="software-title" class="section-y bg-summit text-white">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-16">
      <h2 id="software-title" class="text-h2 lg:col-span-4">
        {t.software.title}
      </h2>
      <p class="max-w-[68ch] text-lg leading-relaxed text-white/85 lg:col-span-8">
        {t.software.text}
      </p>
    </div>

    <!-- Pięć programów w jednym rzędzie na desktopie; każdy kafel ma etykietę, do czego program służy. -->
    <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:mt-16 lg:grid-cols-5 lg:gap-x-6">
      {softwareBrands.map((brand) => (
        <li class="flex flex-col">
          <span class="flex h-24 items-center justify-center rounded bg-white px-5">
            {brand.logo ? (
              <Image
                src={brand.logo}
                alt={brand.name}
                class="max-h-11 w-auto max-w-full object-contain"
              />
            ) : (
              // TODO(klient): brak pliku logo – do tego czasu nazwa programu złożona czcionką nagłówków.
              <span class="font-display text-summit text-2xl font-semibold" aria-hidden="true">
                {brand.short ?? brand.name}
              </span>
            )}
          </span>
          <span class="mt-4 text-xs font-semibold tracking-[0.08em] text-white/65 uppercase">
            {t.software.categories[brand.category]}
          </span>
          <span class="mt-1 text-base leading-snug font-medium text-white/95">{brand.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
