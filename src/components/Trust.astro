---
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import { clients } from '../config/clients';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

// Karuzela jest zamknięta w kontenerze strony (nie rozciąga się na cały monitor).
// Żeby pętla nie miała „dziury” przy małej liczbie logo, powtarzamy listę tak, aby jedna
// grupa była zawsze szersza niż kontener (szacunek: wysokość logo 56 px + odstęp 72 px).
const LOGO_HEIGHT = 56;
const GAP = 72;
const groupWidth = clients.reduce(
  (sum, c) => sum + (c.logo.width / c.logo.height) * LOGO_HEIGHT + GAP,
  0,
);
const repeats = Math.max(1, Math.ceil(2200 / groupWidth));
const items = Array.from({ length: repeats }, () => clients).flat();
---

<section
  id="trust"
  aria-labelledby="trust-title"
  class="trust section-y border-mist overflow-hidden border-t"
  data-paused="false"
  data-label-pause={t.a11y.pause}
  data-label-play={t.a11y.play}
>
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
    <h2 id="trust-title" class="text-summit text-h3">
      {t.trust.title}
    </h2>
    <button
      type="button"
      class="trust-toggle"
      aria-pressed="false"
      aria-label={t.a11y.pause}
      title={t.a11y.pause}
    >
      <Pause class="icon-pause" size={22} stroke-width={2} aria-hidden="true" />
      <Play class="icon-play" size={22} stroke-width={2} aria-hidden="true" />
    </button>
  </div>

  <div class="container-page">
    <div class="marquee mt-10" role="region" aria-label={t.trust.label}>
      <div class="track">
        <ul class="group">
          {items.map((c, i) => {
            // Czytniki ekranu dostają każdego klienta raz – powtórzenia służą tylko wypełnieniu pętli.
            const decorative = i >= clients.length;
            return (
              <li aria-hidden={decorative ? 'true' : undefined}>
                <img
                  src={c.logo.src}
                  width={c.logo.width}
                  height={c.logo.height}
                  alt={decorative ? '' : c.name}
                  loading="eager"
                  decoding="async"
                  class="client-logo"
                />
              </li>
            );
          })}
        </ul>
        <!-- Kopia dla płynnej pętli: ukryta przed czytnikami ekranu. -->
        <ul class="group group-copy" aria-hidden="true">
          {items.map((c) => (
            <li>
              <img
                src={c.logo.src}
                width={c.logo.width}
                height={c.logo.height}
                alt=""
                loading="eager"
                decoding="async"
                class="client-logo"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation-name: marquee-scroll;
    animation-duration: 48s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 4.5rem;
    padding-right: 4.5rem;
    list-style: none;
    margin: 0;
  }
  .client-logo {
    height: 3.5rem;
    width: auto;
    max-width: none;
    filter: grayscale(1);
    opacity: 0.55;
    transition:
      filter 0.25s ease,
      opacity 0.25s ease;
  }
  .client-logo:hover {
    filter: grayscale(0);
    opacity: 1;
  }

  /* Pauza: po najechaniu (mysz) i na życzenie przyciskiem (klawiatura, dotyk). */
  .marquee:hover .track,
  .trust[data-paused='true'] .track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* Przycisk pauzy: sama ikona, bez ramki. Lekko przygaszony, pełny po najechaniu na sekcję lub po fokusie
     (na dotykowych ekranach zostaje widoczny, bo tam nie ma najechania). */
  .trust-toggle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--color-slate);
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }
  .trust:hover .trust-toggle,
  .trust-toggle:focus-visible {
    opacity: 1;
  }
  .trust-toggle:hover {
    background: rgb(0 49 116 / 0.08);
  }
  .trust-toggle .icon-play,
  .trust-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }
  .trust-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  /* Ograniczony ruch: statyczna siatka zamiast przewijania, bez przycisku i bez kopii. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      width: auto;
      justify-content: center;
    }
    .group {
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem 3rem;
      padding: 0 1.5rem;
    }
    .group-copy,
    .trust-toggle {
      display: none;
    }
    .marquee {
      mask-image: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#trust');
  const button = section?.querySelector<HTMLButtonElement>('.trust-toggle');

  if (section && button) {
    button.addEventListener('click', () => {
      const paused = section.dataset.paused !== 'true';
      const label = (paused ? section.dataset.labelPlay : section.dataset.labelPause) ?? '';
      section.dataset.paused = String(paused);
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    });
  }
</script>
