---
import { homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
const home = homePath(lang);

// Kształt pochodzi z oryginalnego logo Everest: wypełniony obszar (wykres) oraz linia nad nim
// z przesuniętymi szczytami. Współrzędne przeskalowane z viewBox logo do 1440×640.
const area = 'M0 455 L272 329 L582 470 L875 250 L1154 376 L1440 325';
const echo = 'M0 308 L309 196 L582 298 L878 88 L1176 250 L1440 189';
---

<section
  class="hero relative isolate flex min-h-[100svh] flex-col overflow-hidden text-white"
  aria-labelledby="hero-title"
>
  <div class="hero-ledger absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page relative z-10 pt-28 pb-10 md:pt-40 md:pb-16 lg:pt-48">
    <h1 id="hero-title" class="max-w-[15ch] text-[clamp(2.75rem,7vw,5.75rem)] font-bold">
      {t.hero.title}
    </h1>
    <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-white/85 md:text-xl">{t.hero.text}</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={`${home}#contact`} class="btn btn-primary">
        {t.hero.primary}
      </a>
      <a href={`${home}#services`} class="btn btn-ghost">
        {t.hero.secondary}
      </a>
    </div>
  </div>

  <svg
    class="relative mt-auto block h-[36svh] min-h-[220px] w-full lg:pointer-events-none lg:absolute lg:inset-x-0 lg:bottom-0 lg:-z-10 lg:h-[58%] lg:min-h-0"
    viewBox="0 0 1440 640"
    preserveAspectRatio="xMaxYMax slice"
    role="img"
    aria-label={t.hero.chartLabel}
  >
    <defs>
      <linearGradient id="ridge-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0a4bb3" stop-opacity="0.95"></stop>
        <stop offset="1" stop-color="#04152f" stop-opacity="1"></stop>
      </linearGradient>
    </defs>

    <g class="ridge-group">
      <!-- Wypełniony obszar wykresu (jak w logo) -->
      <path class="ridge-fill" d={`${area} V800 H0Z`} fill="url(#ridge-fill)"></path>

      <!-- Linia nad obszarem (jak w logo) -->
      <path
        class="ridge-echo"
        d={echo}
        pathLength="1"
        fill="none"
        stroke="#fff"
        stroke-opacity="0.55"
        stroke-width="3"
        stroke-linejoin="round"
        stroke-linecap="round"
      ></path>

      <!-- Krawędź obszaru rysowana jako główna linia wykresu -->
      <path
        class="ridge-line"
        d={area}
        pathLength="1"
        fill="none"
        stroke="#fff"
        stroke-width="3.5"
        stroke-linejoin="round"
        stroke-linecap="round"
      ></path>
      <circle
        class="ridge-dot"
        cx="875"
        cy="250"
        r="8"
        fill="#006aff"
        stroke="#fff"
        stroke-width="3.5"
      ></circle>
    </g>
  </svg>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, #04152f 0%, #052250 65%, #063070 100%);
  }

  /* Linie księgi – ledger rules znikające ku dołowi. */
  .hero-ledger {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 55px,
      rgb(255 255 255 / 0.055) 55px 56px
    );
    mask-image: linear-gradient(to bottom, #000 25%, transparent 80%);
  }

  /* Jedyny „wielki moment” strony: wykres rysuje się po załadowaniu. */
  .ridge-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.6s cubic-bezier(0.55, 0.05, 0.25, 1) 0.4s forwards;
  }
  /* Na desktopie grafika leży pod tekstem hero, więc obniżamy ją, żeby linie nie przecinały akapitu.
     Na mniejszych ekranach wykres jest osobnym blokiem pod tekstem i przesunięcie nie jest potrzebne. */
  @media (min-width: 1024px) {
    .ridge-group {
      transform: translateY(155px);
    }
  }

  .ridge-echo {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.6s cubic-bezier(0.55, 0.05, 0.25, 1) 1.1s forwards;
  }
  .ridge-fill {
    opacity: 0;
    animation: appear 1.4s ease-out 2s forwards;
  }
  .ridge-dot {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.6s cubic-bezier(0.2, 1.4, 0.4, 1) 3s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ridge-line,
    .ridge-echo,
    .ridge-fill,
    .ridge-dot {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
