---
import { homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';
import { contourRings } from '../lib/contours';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
const home = homePath(lang);

// Zatwierdzony profil (z logo Everest): wypełniony obszar + cienka linia nad nim, viewBox 1440×640.
// Czytamy go jak profil terenu. Szczyt z flagą jest w punkcie (875, 250).
type Pt = [number, number];
const AREA: Pt[] = [
  [0, 455],
  [272, 329],
  [582, 470],
  [875, 250],
  [1154, 376],
  [1440, 325],
];
const ECHO: Pt[] = [
  [0, 308],
  [309, 196],
  [582, 298],
  [878, 88],
  [1176, 250],
  [1440, 189],
];

// Łańcuch gór: w środku zatwierdzony profil, a po obu stronach kolejne pasma są coraz niższe, aż do
// płaskiej równiny (y = 468, na dole kadru zostaje z niej cienki pas). Punkty są ustawione ręcznie,
// żeby teren wyglądał na zaprojektowany, a nie na powtórzony wzór. Skrypt na dole pliku dobiera
// viewBox tak, żeby szczyt zawsze leżał na ok. 60% szerokości ekranu.
const LEFT_OUT: Pt[] = [
  [-300, 412],
  [-560, 372],
  [-840, 436],
  [-1150, 424],
  [-1500, 448],
  [-1900, 438],
  [-2400, 456],
  [-3000, 462],
  [-3900, 467],
  [-4800, 468],
];
const RIGHT_OUT: Pt[] = [
  [1640, 372],
  [1800, 318],
  [2150, 396],
  [2520, 366],
  [2950, 422],
  [3400, 410],
  [3950, 446],
  [4600, 461],
  [5300, 467],
  [6000, 468],
];
// Dalsze wzgórza: druga, jaśniejsza warstwa w tle. Szczyty i doliny następują naprzemiennie w
// nieregularnych odstępach; z dala od środka profil spłaszcza się ku równinie. W środku wystaje tylko
// w dolinach głównego łańcucha i za jego skrajnymi szczytami. Bez losowości – build zawsze daje to samo.
const FAR: Pt[] = [];
{
  const spacing = [190, 230, 170, 250, 210, 180, 240, 200];
  const jitter = [0.7, 1.0, 0.55, 0.9, 0.8, 1.1];
  let x = -5000;
  let i = 0;
  while (x <= 5600) {
    const d = Math.abs(x - 760);
    const base = 466 - (466 - 388) * Math.exp(-d / 2300); // ku równinie z dala od środka
    const amp = 46 * Math.exp(-d / 3000) + 8;
    const sign = i % 2 === 0 ? -1 : 1; // naprzemiennie szczyt / dolina
    FAR.push([x, base + sign * amp * (jitter[i % jitter.length] ?? 1)]);
    x += spacing[i % spacing.length] ?? 200;
    i++;
  }
}

const toPath = (pts: Pt[]) =>
  'M' + pts.map(([x, y]) => `${x.toFixed(0)} ${y.toFixed(1)}`).join(' L');
const near: Pt[] = [...LEFT_OUT.slice().reverse(), ...AREA, ...RIGHT_OUT];
const nearTop = toPath(near);
const nearFill = `${nearTop} V800 H${near[0]![0]} Z`;
const farTop = toPath(FAR);
const farFill = `${farTop} V800 H${FAR[0]![0]} Z`;
const echo = toPath(ECHO);
// Echo po bokach: ta sama linia, co główny łańcuch, uniesiona o ok. 140 jednostek (jak w logo),
// z maską zanikającą z dala od środka – dzięki temu nie urywa się w powietrzu na szerokich ekranach.
const echoExt =
  'M0 308 L' +
  LEFT_OUT.filter(([x]) => x >= -1900)
    .map(([x, y]) => `${x} ${y - 147}`)
    .join(' L') +
  ' M1440 189 L' +
  RIGHT_OUT.filter(([x]) => x <= 3000)
    .map(([x, y]) => `${x} ${y - 136}`)
    .join(' L');

// Warstwice wokół szczytu: środek rysunku (720, 560); element jest ustawiany tak, by środek wypadał
// na szczycie, a jego szerokość ma limit (pierścienie nie rosną w nieskończoność).
const rings = contourRings({ cx: 720, cy: 560, rings: 17, r0: 34, dr: 40 });
---

<section
  class="hero text-ink relative isolate flex min-h-[min(100svh,64rem)] flex-col overflow-hidden"
  aria-labelledby="hero-title"
>
  <svg
    class="hero-contours"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    {rings.map((r, i) => (
      <path
        class="ring"
        style={`--i:${i}`}
        d={r.d}
        pathLength="1"
        fill="none"
        stroke="#003174"
        stroke-opacity={r.major ? 0.26 : 0.13}
        stroke-width={r.major ? 1.4 : 0.9}
      />
    ))}
  </svg>

  <div class="container-page relative z-10 pt-28 pb-10 md:pt-[clamp(7rem,17vh,10rem)] md:pb-16 lg:pt-[clamp(6.5rem,17vh,12rem)]">
    <h1 id="hero-title" class="text-h1 max-w-[24ch]">
      {t.hero.title}
    </h1>
    <p class="text-ink/85 mt-6 max-w-[52ch] text-lg leading-relaxed md:text-xl">{t.hero.text}</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={`${home}#contact`} class="btn btn-primary">
        {t.hero.primary}
      </a>
      <a href={`${home}#services`} class="btn btn-outline">
        {t.hero.secondary}
      </a>
    </div>
  </div>

  <svg
    class="ridge-svg"
    viewBox="0 0 1440 640"
    preserveAspectRatio="xMaxYMax slice"
    role="img"
    aria-label={t.hero.chartLabel}
  >
    <defs>
      <linearGradient
        id="echo-fade-grad"
        gradientUnits="userSpaceOnUse"
        x1="660"
        y1="0"
        x2="980"
        y2="0"
      >
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="1"></stop>
      </linearGradient>
      <linearGradient
        id="echo-ext-grad"
        gradientUnits="userSpaceOnUse"
        x1="-1300"
        y1="0"
        x2="2740"
        y2="0"
      >
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.0248" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.297" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="0.703" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="0.975" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <mask
        id="echo-ext-fade"
        maskUnits="userSpaceOnUse"
        x="-1400"
        y="-400"
        width="4300"
        height="1600"
      >
        <rect x="-1400" y="-400" width="4300" height="1600" fill="url(#echo-ext-grad)"></rect>
      </mask>
      <mask id="echo-fade" maskUnits="userSpaceOnUse" x="-200" y="-400" width="1900" height="1600">
        <rect x="-200" y="-400" width="1900" height="1600" fill="url(#echo-fade-grad)"></rect>
      </mask>
    </defs>

    <g class="ridge-group">
      <!-- Dalsze wzgórza: jaśniejsza warstwa w tle (płaski kolor, bez gradientu) -->
      <g class="mass-far">
        <path d={farFill} fill="#8ba5cd"></path>
      </g>
      <!-- Tylko do pomiaru kolizji z tekstem (bez obrysu) -->
      <path class="far-line" d={farTop} fill="none" stroke="none"></path>

      <!-- Linia nad górą (jak w logo): cienka, w tle -->
      <path
        class="ridge-echo"
        d={echo}
        pathLength="1"
        fill="none"
        stroke="#003174"
        stroke-opacity="0.5"
        stroke-width="2"
        stroke-linejoin="round"
        stroke-linecap="round"
      ></path>

      <!-- Echo po bokach: pojawia się po narysowaniu środkowej linii i zanika z dala od środka -->
      <g mask="url(#echo-ext-fade)">
        <path
          class="ridge-echo-ext"
          d={echoExt}
          fill="none"
          stroke="#003174"
          stroke-opacity="0.5"
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"
        ></path>
      </g>

      <!-- Główny łańcuch = wykres wzrostu. Płaski granat, bez gradientu. -->
      <g class="mass">
        <path class="ridge-fill" d={nearFill} fill="#003174"></path>
        <path
          class="ridge-line"
          d={nearTop}
          fill="none"
          stroke="#003174"
          stroke-width="2"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </g>

      <!-- Flaga na szczycie: cel osiągnięty -->
      <g class="summit-flag">
        <line
          class="flag-pole"
          x1="875"
          y1="250"
          x2="875"
          y2="188"
          stroke="#0b1f3f"
          stroke-width="3.5"
          stroke-linecap="round"
        ></line>
        <g class="flutter">
          <path class="flag-pennant" d="M875 188 L922 203 L875 218 Z" fill="#f26a1b"></path>
        </g>
      </g>
    </g>
  </svg>
</section>

<style>
  .hero {
    background: var(--color-ice);
  }

  /* Warstwice: środek pierścieni leży na szczycie (60,76% szerokości), a szerokość ma limit,
     więc na dużych ekranach nie rozciągają się na pół monitora. */
  .hero-contours {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 60.76%;
    z-index: -10;
    width: min(100%, 2200px);
    height: 100%;
    transform: translateX(-50%);
    -webkit-mask-image: radial-gradient(ellipse 60% 75% at 50% 62%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 60% 75% at 50% 62%, #000 20%, transparent 78%);
  }

  /*
   * Wykres ma trzy układy (wybiera je skrypt na dole pliku, na podstawie pomiaru):
   *  - domyślnie na desktopie: „nakładka” – wykres leży pod tekstem, szczyt obok nagłówka,
   *  - data-echo="fade" / "off": lewa część linii-echa wygasa albo jest ukryta (nie przecina akapitu),
   *  - data-mode="stacked": wykres jest osobnym blokiem pod tekstem (jak na telefonie).
   * Bez JavaScriptu działa układ domyślny.
   */
  .ridge-svg {
    position: relative;
    display: block;
    width: 100%;
    margin-top: auto;
    height: 36svh;
    min-height: 220px;
    /* Górny brzeg SVG wygasza się płynnie (nie ma twardego cięcia). */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 16%);
    mask-image: linear-gradient(to bottom, transparent, #000 16%);
  }
  @media (min-width: 1024px) {
    /* Na niskich oknach nagłówek nie może zabierać więcej niż ~10,5% wysokości – zostaje miejsce na wykres. */
    .hero h1 {
      font-size: min(clamp(2.1rem, 1.25rem + 4.4vw, 5.25rem), 10.5vh);
    }
    .hero:not([data-mode='stacked']) .ridge-svg {
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      z-index: -10;
      height: 58%;
      min-height: 0;
      margin-top: 0;
      pointer-events: none;
    }
    .hero:not([data-mode='stacked']) .ridge-group {
      transform: translateY(155px);
    }
    .hero[data-shift='low']:not([data-mode='stacked']) .ridge-group {
      transform: translateY(225px);
    }
    .hero[data-shift='lower']:not([data-mode='stacked']) .ridge-group {
      transform: translateY(290px);
    }
    .hero[data-mode='stacked'] .ridge-svg {
      /* 40,3 vw = 580 z 640 jednostek wysokości rysunku (skala ograniczona do 1,32 → max. ok. 766 px):
         widać szczyt, flagę (poniżej strefy wygaszania) i całą linię */
      height: clamp(260px, min(40.3vw, 770px), 800px);
    }
  }
  .hero[data-echo='fade'] .ridge-echo,
  .hero[data-echo='fade'] .ridge-echo-ext {
    mask: url(#echo-fade);
  }
  .hero[data-echo='off'] .ridge-echo,
  .hero[data-echo='off'] .ridge-echo-ext {
    display: none;
  }

  /*
   * JEDYNA animacja strony (przy ładowaniu), w tej kolejności:
   *  1. warstwice rysują się od środka na zewnątrz,
   *  2. dalsze wzgórza, a chwilę później główny łańcuch wyrastają od podstawy,
   *  3. cienka linia nad nim się rysuje,
   *  4. flaga zostaje wbita na szczycie (maszt, potem proporczyk, krótkie załopotanie).
   * Punkty obrotu podajemy w jednostkach rysunku, żeby działały tak samo we wszystkich przeglądarkach.
   */
  .ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ring-draw 1.7s cubic-bezier(0.4, 0.1, 0.2, 1) forwards;
    animation-delay: calc(0.1s + var(--i) * 0.07s);
  }
  .mass-far {
    transform-origin: 0 800px;
    transform: scaleY(0);
    animation: mass-grow 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s forwards;
  }
  .mass {
    transform-origin: 0 800px;
    transform: scaleY(0);
    animation: mass-grow 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.6s forwards;
  }
  .ridge-echo {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ring-draw 1.7s cubic-bezier(0.4, 0.1, 0.2, 1) 1.6s forwards;
  }
  .ridge-echo-ext {
    opacity: 0;
    animation: fade-in 0.9s ease-out 2.7s forwards;
  }
  .flag-pole {
    transform-origin: 875px 250px;
    transform: scaleY(0);
    animation: pole-up 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) 2.5s forwards;
  }
  .flag-pennant {
    transform-origin: 875px 203px;
    transform: scaleX(0);
    animation: unfurl 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.15) 2.9s forwards;
  }
  .flutter {
    transform-origin: 875px 203px;
    animation: flutter 1.3s ease-in-out 3.5s 2;
  }

  @keyframes ring-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
  @keyframes mass-grow {
    to {
      transform: scaleY(1);
    }
  }
  @keyframes pole-up {
    to {
      transform: scaleY(1);
    }
  }
  @keyframes unfurl {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes flutter {
    0%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(-4deg);
    }
    65% {
      transform: rotate(3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .ridge-echo,
    .ridge-echo-ext,
    .mass-far,
    .mass,
    .flag-pole,
    .flag-pennant,
    .flutter {
      animation: none;
      stroke-dashoffset: 0;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  // Układ rysunku i pomiar kolizji z tekstem.
  //
  // 1) viewBox ustawiamy tak, żeby szczyt (x = 875) zawsze leżał na ok. 60,8% szerokości ramki
  //    (jak w zatwierdzonej kompozycji 1440 px), a skala rysunku nie przekraczała 1900/1440.
  //    Po bokach widać wtedy kolejne, coraz niższe pasma gór.
  // 2) Sprawdzamy, czy linie wykresu (w układzie „nakładka”) przecinałyby tekst hero. Jeśli tak,
  //    obniżamy wykres, wygaszamy/ukrywamy linię-echo albo przenosimy wykres pod tekst.
  //    Liczymy wyłącznie widoczną część rysunku (to, co nie mieści się w ramce SVG, jest przycinane).
  //
  // Współrzędne punktów na ekranie liczymy WŁASNYM wzorem, a nie przez getScreenCTM()/
  // getBoundingClientRect() elementów SVG – przeglądarki różnią się w tym, jak uwzględniają
  // transformacje CSS i animacje.
  const hero = document.querySelector<HTMLElement>('.hero');
  const svg = hero?.querySelector<SVGSVGElement>('.ridge-svg');
  const group = hero?.querySelector<SVGGElement>('.ridge-group');
  const mainLine = hero?.querySelector<SVGPathElement>('.ridge-line');
  const farLine = hero?.querySelector<SVGPathElement>('.far-line');
  const echoLine = hero?.querySelector<SVGPathElement>('.ridge-echo');
  const echoExt = hero?.querySelector<SVGPathElement>('.ridge-echo-ext');

  const REF_W = 1440; // szerokość zatwierdzonej kompozycji
  const VB_H = 640;
  const SUMMIT_X = 875;
  const SUMMIT_FRAC = SUMMIT_X / REF_W; // ok. 60,8% szerokości
  const SCALE_CAP = 1900 / REF_W;
  const FLAG = { x: SUMMIT_X, top: 186, bottom: 220 }; // maszt i proporczyk (współrzędne rysunku)
  const ECHO_FADE_FROM = 660; // musi być zgodne z gradientem #echo-fade-grad
  const ECHO_FADE_TO = 980;
  const TOP_FADE = 0.16; // górne 16% SVG wygasza maska (.ridge-svg)
  const MARGIN = 6;

  let scale = 1; // bieżąca skala rysunku (px na jednostkę rysunku)

  /** Dopasowuje viewBox do ramki: szczyt na ~60,8% szerokości, dół rysunku przy dolnej krawędzi. */
  const layout = (box: DOMRect) => {
    scale = Math.max(Math.min(box.width / REF_W, SCALE_CAP), box.height / VB_H);
    const w = box.width / scale;
    const h = box.height / scale;
    const x0 = SUMMIT_X - SUMMIT_FRAC * w;
    svg?.setAttribute('viewBox', `${x0} ${VB_H - h} ${w} ${h}`);
  };

  /** Bieżące przesunięcie grupy w pionie (ustawiane w CSS zależnie od data-shift). */
  const groupShift = (): number => {
    if (!group) return 0;
    const t = getComputedStyle(group).transform;
    return t && t !== 'none' ? new DOMMatrix(t).m42 : 0;
  };

  const toScreen = (x: number, y: number, box: DOMRect, shift: number) => ({
    x: box.left + SUMMIT_FRAC * box.width + (x - SUMMIT_X) * scale,
    y: box.bottom - (VB_H - (y + shift)) * scale,
  });

  const countHits = (
    path: SVGPathElement,
    box: DOMRect,
    rects: DOMRect[],
    faded: boolean,
  ): number => {
    const length = path.getTotalLength();
    const shift = groupShift();
    const steps = Math.min(3000, Math.max(300, Math.ceil(length / 6)));
    let hits = 0;
    for (let i = 0; i <= steps; i++) {
      const p = path.getPointAtLength((length * i) / steps);
      const { x, y } = toScreen(p.x, p.y, box, shift);
      if (x < box.left || x > box.right || y < box.top || y > box.bottom) continue; // przycięte
      const alphaY = Math.min(1, (y - box.top) / (box.height * TOP_FADE));
      const alphaX = faded
        ? Math.min(1, Math.max(0, (p.x - ECHO_FADE_FROM) / (ECHO_FADE_TO - ECHO_FADE_FROM)))
        : 1;
      if (alphaX * alphaY < 0.25) continue; // praktycznie niewidoczne
      const inText = rects.some(
        (r) =>
          x > r.left - MARGIN &&
          x < r.right + MARGIN &&
          y > r.top - MARGIN &&
          y < r.bottom + MARGIN,
      );
      if (inText) hits++;
    }
    return hits;
  };

  /** Czy maszt i proporczyk mieszczą się w ramce SVG, poniżej strefy wygaszania u góry? */
  const flagVisible = (box: DOMRect): boolean => {
    const shift = groupShift();
    const top = toScreen(FLAG.x, FLAG.top, box, shift);
    const bottom = toScreen(FLAG.x, FLAG.bottom, box, shift);
    return (
      top.x >= box.left &&
      top.x <= box.right &&
      top.y >= box.top + box.height * TOP_FADE &&
      bottom.y <= box.bottom - 8
    );
  };

  const evaluate = () => {
    if (!hero || !svg || !mainLine || !farLine || !echoLine || !echoExt) return;
    delete hero.dataset.mode;
    delete hero.dataset.echo;
    delete hero.dataset.shift;

    layout(svg.getBoundingClientRect());
    if (!window.matchMedia('(min-width: 1024px)').matches) return; // telefon/tablet: zawsze pod tekstem

    let box = svg.getBoundingClientRect();
    const rects = Array.from(hero.querySelectorAll('h1, p, .btn')).map((el) =>
      el.getBoundingClientRect(),
    );

    // Krok 1: nakładka; krok 2–3: obniżamy wykres; jeśli nadal koliduje – układ „pod tekstem”.
    const mainHits = () =>
      countHits(mainLine, box, rects, false) + countHits(farLine, box, rects, false);
    let ok = false;
    for (const shift of [undefined, 'low', 'lower']) {
      if (shift) hero.dataset.shift = shift;
      if (mainHits() === 0 && flagVisible(box)) {
        ok = true;
        break;
      }
    }
    if (!ok) {
      delete hero.dataset.shift;
      hero.dataset.mode = 'stacked';
      layout(svg.getBoundingClientRect()); // ramka zmienia wysokość – przeliczamy viewBox
      return;
    }

    // Linia-echo to akcent: jeśli przecina tekst, najpierw wygaszamy jej lewą część,
    // a gdy to nie wystarcza – ukrywamy ją (wykres zostaje w układzie „nakładka”).
    const echoHits = (faded: boolean) =>
      countHits(echoLine, box, rects, faded) + countHits(echoExt, box, rects, faded);
    if (echoHits(false) > 0) {
      hero.dataset.echo = 'fade';
      if (echoHits(true) > 0) hero.dataset.echo = 'off';
    }
  };

  let timer: number | undefined;
  const schedule = () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(evaluate, 120);
  };

  evaluate();
  window.addEventListener('resize', schedule);
  window.addEventListener('load', schedule);
  // Zmiana rozmiaru tekstu (załadowanie docelowej czcionki, zoom, zmiana szerokości) wymaga
  // ponownego pomiaru. Obserwujemy tylko tekst, nie cały hero – zmiana układu wykresu nie
  // zmienia rozmiaru tekstu, więc nie ma pętli.
  if ('ResizeObserver' in window && hero) {
    const observer = new ResizeObserver(schedule);
    hero.querySelectorAll('h1, p').forEach((el) => observer.observe(el));
  }
  document.fonts?.ready.then(schedule);
</script>
