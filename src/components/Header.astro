---
import Logo from './Logo.astro';
import { homePath, aboutPath, pagePath, otherLang, type Lang, type PageKey } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
  page: PageKey;
}
const { t, lang, page } = Astro.props;
const home = homePath(lang);
const alt = otherLang(lang);

const links = [
  { href: `${home}#services`, label: t.nav.services, current: false },
  { href: `${home}#info`, label: t.nav.info, current: false },
  { href: aboutPath(lang), label: t.nav.about, current: page === 'about' },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50 text-white">
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href={home} aria-label={t.a11y.home} class="rounded-md">
      <Logo class="h-14" />
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.95rem] font-medium">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.current ? 'page' : undefined}
              class:list={[
                'decoration-signal underline-offset-[10px] hover:underline hover:decoration-2',
                l.current && 'underline decoration-2',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={pagePath(page, alt)}
        hreflang={alt}
        lang={alt}
        aria-label={t.a11y.switchLang}
        class="rounded-md px-2 py-1 text-sm font-semibold tracking-wide opacity-80 hover:opacity-100"
      >
        {alt.toUpperCase()}
      </a>
      <a href={`${home}#contact`} class="btn btn-primary hidden !py-2.5 lg:inline-flex">
        {t.nav.contact}
      </a>
      <button
        type="button"
        popovertarget="menu"
        aria-label={t.a11y.openMenu}
        class="-mr-2 rounded-md p-2 lg:hidden"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="menu" popover class="mobile-menu">
    <div class="flex h-20 items-center justify-between">
      <Logo class="h-14" />
      <button
        type="button"
        popovertarget="menu"
        popovertargetaction="hide"
        aria-label={t.a11y.closeMenu}
        class="-mr-2 rounded-md p-2"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <nav aria-label={t.a11y.mainNav} class="mt-10">
      <ul class="space-y-1 text-3xl font-semibold">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.current ? 'page' : undefined} class="block py-3">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={`${home}#contact`} class="btn btn-primary mt-8">
        {t.nav.contact}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Bez wsparcia scroll-driven animations nagłówek jest po prostu pełnym granatem. */
  .site-header {
    background: var(--color-night);
  }

  @supports (animation-timeline: scroll()) {
    .site-header {
      background: transparent;
      /* Osobne właściwości zamiast skrótu `animation` – minifikator CSS scala skrót z
         animation-timeline, a część przeglądarek odrzuca taki zapis. */
      animation-name: header-solid;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 140px;
    }
    @keyframes header-solid {
      to {
        background: rgb(4 21 47 / 0.92);
        backdrop-filter: blur(12px);
        box-shadow: 0 1px 0 rgb(255 255 255 / 0.08);
      }
    }
  }

  /* `display` ustawiamy tylko dla otwartego popovera, by nie nadpisać domyślnego ukrywania. */
  .mobile-menu {
    margin: 0;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    border: 0;
    padding: 0 1.5rem 2rem;
    background: var(--color-night);
    color: #fff;
    overflow-y: auto;
  }
  .mobile-menu:popover-open {
    display: block;
  }
</style>

<script>
  // Po kliknięciu linku w menu mobilnym zamykamy popover (przeskok do sekcji / nowa strona).
  const menu = document.getElementById('menu');
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu.hidePopover());
  });
</script>
