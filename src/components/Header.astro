---
import Globe from '@lucide/astro/icons/globe';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Logo from './Logo.astro';
import { homePath, pagePath, otherLang, type Lang, type PageKey } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
  page: PageKey;
}
const { t, lang, page } = Astro.props;
const home = homePath(lang);
const alt = otherLang(lang);

interface Child {
  href: string;
  label: string;
  current: boolean;
}
interface Item {
  id: string;
  href: string;
  label: string;
  /** Wyróżnienie w pasku (np. gdy jesteśmy na podstronie z tej grupy). */
  active: boolean;
  children?: Child[];
}

// Pozycje grupowe: nazwa jest zwykłym linkiem do sekcji, a rozwijana lista jest osobnym przyciskiem
// (działa na najechanie, klik, dotyk i klawiaturę).
const items: Item[] = [
  {
    id: 'about',
    href: `${home}#about`,
    label: t.nav.about,
    active: page === 'team',
    children: [
      { href: `${home}#cooperation`, label: t.nav.cooperation, current: false },
      { href: pagePath('team', lang), label: t.nav.team, current: page === 'team' },
    ],
  },
  {
    id: 'offer',
    href: `${home}#services`,
    label: t.nav.offer,
    active: page === 'faq',
    children: [
      { href: `${home}#services`, label: t.nav.services, current: false },
      { href: `${home}#software`, label: t.nav.software, current: false },
      { href: pagePath('faq', lang), label: t.nav.faq, current: page === 'faq' },
    ],
  },
  {
    id: 'pricing',
    href: `${home}#pricing`,
    label: t.nav.pricing,
    active: page === 'quote',
    children: [
      { href: `${home}#pricing`, label: t.nav.priceList, current: false },
      { href: pagePath('quote', lang), label: t.nav.quoteWizard, current: page === 'quote' },
    ],
  },
];
---

<header class="site-header text-ink fixed inset-x-0 top-0 z-50">
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href={home} aria-label={t.a11y.home} class="rounded-md">
      <Logo variant="dark" class="h-14" />
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.95rem] font-medium">
        {items.map((item) => (
          <li class:list={['nav-item', item.children && 'has-menu']}>
            <div class="flex items-center gap-0.5">
              <a href={item.href} class:list={['nav-link', item.active && 'is-active']}>
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="submenu-toggle"
                  aria-expanded="false"
                  aria-controls={`submenu-${item.id}`}
                  aria-label={`${t.a11y.expandSubmenu}: ${item.label}`}
                >
                  <ChevronDown size={16} stroke-width={2.2} aria-hidden="true" />
                </button>
              )}
            </div>
            {item.children && (
              <ul id={`submenu-${item.id}`} class="submenu">
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} aria-current={c.current ? 'page' : undefined}>
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={pagePath(page, alt)}
        hreflang={alt}
        lang={alt}
        aria-label={t.a11y.switchLang}
        class="hover:bg-summit/10 inline-flex items-center gap-2 rounded px-2.5 py-1.5 text-sm font-semibold"
      >
        <Globe size={18} stroke-width={1.9} aria-hidden="true" />
        <span class="hidden sm:inline">{t.nav.langName}</span>
        <span class="sm:hidden">{alt.toUpperCase()}</span>
      </a>
      <a href={`${home}#contact`} class="btn btn-primary hidden !py-2.5 lg:inline-flex">
        {t.nav.contact}
      </a>
      <button
        type="button"
        popovertarget="menu"
        aria-label={t.a11y.openMenu}
        class="-mr-2 rounded-md p-2 lg:hidden"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="menu" popover class="mobile-menu">
    <div class="flex h-20 items-center justify-between">
      <Logo variant="dark" class="h-14" />
      <button
        type="button"
        popovertarget="menu"
        popovertargetaction="hide"
        aria-label={t.a11y.closeMenu}
        class="-mr-2 rounded-md p-2"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <nav aria-label={t.a11y.mainNav} class="mt-10">
      <ul class="space-y-1 text-3xl font-semibold">
        {items.map((item) => (
          <li>
            <a href={item.href} class="block py-3">
              {item.label}
            </a>
            {item.children && (
              <ul class="border-mist mb-3 ml-1 space-y-0.5 border-l-2 pl-5 text-xl font-medium">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      aria-current={c.current ? 'page' : undefined}
                      class="block py-2"
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href={`${home}#contact`} class="btn btn-primary mt-8">
        {t.nav.contact}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Nagłówek jest przezroczysty nad hero, a po przewinięciu staje się jasnym paskiem.
     Stan ustawia skrypt (data-scrolled) – działa tak samo we wszystkich przeglądarkach
     (animacje sterowane przewijaniem nie są jeszcze wszędzie obsługiwane). */
  .site-header {
    background: transparent;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .site-header[data-scrolled] {
    background: rgb(243 246 250 / 0.94);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--color-mist);
  }
  /* Bez JavaScriptu pasek jest zawsze pełny, żeby nie zlewał się z treścią pod spodem. */
  @media (scripting: none) {
    .site-header {
      background: var(--color-snow);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .nav-link {
    text-decoration-color: var(--color-glacier);
    text-underline-offset: 10px;
  }
  .nav-link:hover,
  .nav-link.is-active {
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
  }

  .submenu-toggle {
    display: inline-flex;
    padding: 0.35rem;
    border-radius: 0.25rem;
  }
  .submenu-toggle svg {
    transition: transform 0.2s ease;
  }
  .has-menu[data-open] .submenu-toggle svg,
  .has-menu:hover:not([data-suppress]) .submenu-toggle svg {
    transform: rotate(180deg);
  }

  .has-menu {
    position: relative;
  }
  .submenu {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 17rem;
    margin-top: 0.75rem;
    padding: 0.4rem;
    background: var(--color-snow);
    border: 1px solid var(--color-mist);
    border-radius: 0.375rem;
    box-shadow: 0 12px 28px -12px rgb(11 31 63 / 0.25);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0s linear 0.15s;
  }
  /* Niewidzialny mostek, żeby lista nie znikała, gdy kursor przechodzi nad odstępem. */
  .submenu::before {
    content: '';
    position: absolute;
    inset: -0.9rem 0 auto 0;
    height: 0.9rem;
  }
  .has-menu[data-open] .submenu,
  .has-menu:hover:not([data-suppress]) .submenu {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  /* Bez JavaScriptu klawiatura i dotyk też mają dostęp do list. */
  @media (scripting: none) {
    .has-menu:focus-within .submenu {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
  }
  .submenu a {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: 0.25rem;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .submenu a:hover,
  .submenu a[aria-current='page'] {
    background: var(--color-ice);
  }
  .submenu a[aria-current='page'] {
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .submenu,
    .submenu-toggle svg {
      transition: none;
    }
  }

  /* `display` ustawiamy tylko dla otwartego popovera, by nie nadpisać domyślnego ukrywania. */
  .mobile-menu {
    margin: 0;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    border: 0;
    padding: 0 1.5rem 2rem;
    background: var(--color-snow);
    color: var(--color-ink);
    overflow-y: auto;
  }
  .mobile-menu:popover-open {
    display: block;
  }
</style>

<script>
  // Stan „przewinięty”: pasek zyskuje tło, gdy strona zjedzie choćby o kilka pikseli.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // Listy rozwijane: najechanie działa w CSS, a klik/dotyk/klawiatura przez data-open.
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.has-menu'));
  const setOpen = (li: HTMLElement, open: boolean) => {
    li.toggleAttribute('data-open', open);
    li.querySelector('.submenu-toggle')?.setAttribute('aria-expanded', String(open));
  };
  groups.forEach((li) => {
    const toggle = li.querySelector<HTMLElement>('.submenu-toggle');
    toggle?.addEventListener('click', () => {
      const open = !li.hasAttribute('data-open');
      groups.forEach((g) => setOpen(g, false));
      setOpen(li, open);
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && li.hasAttribute('data-open')) {
        setOpen(li, false);
        toggle?.focus();
      }
    });
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node | null)) setOpen(li, false);
    });
    // Po wyborze pozycji lista chowa się, nawet gdy kursor nadal nad nią stoi.
    li.querySelectorAll('.submenu a').forEach((a) =>
      a.addEventListener('click', () => {
        setOpen(li, false);
        li.setAttribute('data-suppress', '');
      }),
    );
    li.addEventListener('mouseleave', () => li.removeAttribute('data-suppress'));
  });
  document.addEventListener('click', (e) => {
    groups.forEach((g) => {
      if (!g.contains(e.target as Node)) setOpen(g, false);
    });
  });

  // Po kliknięciu linku w menu mobilnym zamykamy popover (przeskok do sekcji / nowa strona).
  const menu = document.getElementById('menu');
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu.hidePopover());
  });
</script>
