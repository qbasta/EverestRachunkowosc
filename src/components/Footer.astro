---
import MapPin from '@lucide/astro/icons/map-pin';
import { site } from '../config/site';
import { homePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';
import Logo from './Logo.astro';
import LinkedInIcon from './LinkedInIcon.astro';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;

// Ikony zamiast napisów. Renderujemy tylko te profile, dla których podano adres.
const linkedin = site.social.linkedin;
const google = site.social.google;
const facebook = site.social.facebook;

const iconLink =
  'inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:border-white hover:bg-white hover:text-night';
---

<footer class="bg-deep border-t border-white/10 text-white/80">
  <div class="container-page flex flex-col gap-8 py-10 text-sm md:flex-row md:items-center md:justify-between">
    <a href={homePath(lang)} aria-label={t.a11y.home} class="w-fit rounded-md text-white">
      <Logo />
    </a>

    {(linkedin || google || facebook) && (
      <nav aria-label={t.footer.social}>
        <ul class="flex items-center gap-3">
          {facebook && (
            <li>
              <a
                href={facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="underline-offset-4 hover:text-white hover:underline"
              >
                {t.footer.facebook}
              </a>
            </li>
          )}
          {linkedin && (
            <li>
              <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.footer.linkedin}
                title={t.footer.linkedin}
                class={iconLink}
              >
                <LinkedInIcon size={20} />
              </a>
            </li>
          )}
          {google && (
            <li>
              <a
                href={google}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.footer.google}
                title={t.footer.google}
                class={iconLink}
              >
                <MapPin size={20} stroke-width={1.9} aria-hidden="true" />
              </a>
            </li>
          )}
        </ul>
      </nav>
    )}

    <p>{`© ${new Date().getFullYear()} ${site.name}. ${t.footer.rights}.`}</p>
  </div>
</footer>
