---
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { pagePath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';
import { FAQ_TEASER_IDS } from '../config/faq';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;

// Pytania z listy w config/faq.ts, w tej samej kolejności.
const items = FAQ_TEASER_IDS.flatMap((id) => t.faqPage.items.filter((item) => item.id === id));
const faqHref = pagePath('faq', lang);
---

<section id="faq" aria-labelledby="faq-title" class="section-y">
  <div class="container-page">
    <h2 id="faq-title" class="text-summit text-h2 mx-auto max-w-[24ch] text-center">
      {t.faq.title}
    </h2>

    <!-- Strzałki po bokach kart (na telefonie pod kartami). Pokazuje je dopiero skrypt – bez JS karuzela
         nadal przewija się palcem lub klawiaturą. -->
    <div
      data-faq-carousel
      role="region"
      aria-roledescription="carousel"
      aria-labelledby="faq-title"
      class="faq-carousel mt-10 lg:mt-12"
    >
      <button type="button" class="faq-arrow faq-prev" data-faq-prev aria-label={t.faq.prev} hidden>
        <ChevronLeft class="size-6" aria-hidden="true" />
      </button>
      <div class="faq-track" data-faq-track tabindex="0">
        {items.map((item, i) => (
          <article
            role="group"
            aria-roledescription="slide"
            aria-label={t.faq.slide
              .replace('{n}', String(i + 1))
              .replace('{total}', String(items.length))}
            class="faq-card"
          >
            <span class="faq-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display text-summit mt-3 text-[1.35rem] leading-snug font-semibold">
              {item.q}
            </h3>
            <p class="text-ink/85 mt-4 line-clamp-6">{item.a[0]}</p>
            <a
              href={`${faqHref}#${item.id}`}
              class="faq-more tlink mt-auto pt-6"
              aria-label={`${t.faq.more}: ${item.q}`}
            >
              {t.faq.more}
              <ArrowRight class="size-4 shrink-0" stroke-width={2.25} aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
      <button type="button" class="faq-arrow faq-next" data-faq-next aria-label={t.faq.next} hidden>
        <ChevronRight class="size-6" aria-hidden="true" />
      </button>
    </div>

    <!-- Wyraźny, wyśrodkowany przycisk; strzałka przesuwa się po najechaniu. -->
    <div class="mt-10 flex justify-center lg:mt-12">
      <a href={faqHref} class="btn btn-primary faq-cta w-full sm:w-auto">
        {t.faq.cta}
        <ArrowRight class="faq-cta-arrow size-5 shrink-0" stroke-width={2.25} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .faq-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 0.75rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq-track {
      scroll-behavior: smooth;
    }
  }
  .faq-card {
    display: flex;
    flex: 0 0 88%;
    flex-direction: column;
    scroll-snap-align: start;
    background: var(--color-ice);
    border-top: 3px solid var(--color-summit);
    padding: 1.75rem;
  }
  @media (min-width: 40rem) {
    .faq-card {
      flex-basis: calc(50% - 0.75rem);
    }
  }
  .faq-num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
    color: color-mix(in srgb, var(--color-summit) 32%, transparent);
  }
  .faq-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
  }
  .faq-carousel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .faq-track {
    grid-column: 1 / -1;
    order: -1;
  }
  .faq-arrow {
    display: inline-flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-summit);
    border-radius: 999px;
    color: var(--color-summit);
    background: #fff;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .faq-arrow[hidden] {
    display: none;
  }
  .faq-prev {
    justify-self: end;
  }
  .faq-arrow:hover:not([aria-disabled='true']) {
    background: var(--color-summit);
    color: #fff;
  }
  .faq-arrow[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }
  /* Od tabletu: strzałka – karty – strzałka w jednym rzędzie, strzałki na wysokości środka kart. */
  @media (min-width: 48rem) {
    .faq-carousel {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 1.25rem;
    }
    .faq-track {
      grid-column: auto;
      order: 0;
    }
  }
  .faq-cta {
    gap: 0.6rem;
    padding-inline: 2.25rem;
    box-shadow: 0 12px 26px -14px rgb(0 40 100 / 0.6);
  }
  .faq-cta-arrow {
    transition: transform 0.2s ease;
  }
  .faq-cta:hover .faq-cta-arrow {
    transform: translateX(5px);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-cta-arrow {
      transition: none;
    }
  }
</style>

<script>
  // Ręczna karuzela: przewijanie o jedną kartę, stan przycisków wynika z pozycji przewinięcia.
  const root = document.querySelector<HTMLElement>('[data-faq-carousel]');
  const track = root?.querySelector<HTMLElement>('[data-faq-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-faq-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-faq-next]');

  if (track && prev && next) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;

    const update = () => {
      ticking = false;
      const max = track.scrollWidth - track.clientWidth;
      // Wszystkie karty mieszczą się naraz – strzałki są zbędne.
      prev.hidden = next.hidden = max <= 1;
      prev.setAttribute('aria-disabled', String(track.scrollLeft <= 1));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= max - 1));
    };
    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (card?.getBoundingClientRect().width ?? track.clientWidth) + gap;
    };
    const move = (dir: 1 | -1) => (button: HTMLButtonElement) => {
      if (button.getAttribute('aria-disabled') === 'true') return;
      track.scrollBy({ left: dir * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    prev.addEventListener('click', () => move(-1)(prev));
    next.addEventListener('click', () => move(1)(next));
    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);
    // Układ może ustalić się już po uruchomieniu skryptu (np. Safari) – obserwujemy rozmiary toru i kart.
    const observer = new ResizeObserver(schedule);
    observer.observe(track);
    for (const card of Array.from(track.children)) observer.observe(card);
    update();
  }
</script>
