---
import Contours from './Contours.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="bg-ice text-ink relative isolate overflow-hidden" aria-labelledby="page-title">
  <Contours
    class="text-summit pointer-events-none absolute inset-0 -z-10 h-full w-full"
    style="-webkit-mask-image: linear-gradient(to left, #000 0%, transparent 70%); mask-image: linear-gradient(to left, #000 0%, transparent 70%);"
    cx={1120}
    cy={260}
    rings={12}
    r0={26}
    dr={44}
    rot={-10}
  />
  <div class="container-page pt-36 pb-16 md:pt-44 md:pb-20">
    <h1 id="page-title" class="text-h1">
      {title}
    </h1>
  </div>
</section>
