---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section
  class="page-header relative isolate overflow-hidden text-white"
  aria-labelledby="page-title"
>
  <div class="ledger absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-page pt-36 pb-16 md:pt-44 md:pb-20">
    <h1 id="page-title" class="text-[clamp(2.75rem,7vw,5.5rem)] font-bold">
      {title}
    </h1>
  </div>
</section>

<style>
  .page-header {
    background: linear-gradient(180deg, #04152f 0%, #052250 100%);
  }
  .ledger {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 55px,
      rgb(255 255 255 / 0.055) 55px 56px
    );
    mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
  }
</style>
