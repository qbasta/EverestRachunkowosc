---
import Contours from './Contours.astro';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section
  id="cooperation"
  aria-labelledby="cooperation-title"
  class="section-y bg-ice relative isolate overflow-hidden"
>
  <Contours
    class="text-summit pointer-events-none absolute inset-0 -z-10 h-full w-full"
    style="-webkit-mask-image: linear-gradient(to left, #000 0%, transparent 62%); mask-image: linear-gradient(to left, #000 0%, transparent 62%);"
    cx={1250}
    cy={330}
    rings={14}
    r0={30}
    dr={46}
    rot={8}
  />
  <div class="container-page">
    <h2 id="cooperation-title" class="text-summit text-h2">
      {t.cooperation.title}
    </h2>
    <!-- Hasło jako duży cytat na całą szerokość: inny rytm niż pozostałe sekcje. -->
    <p class="font-display text-summit mt-10 max-w-[24ch] text-[clamp(1.9rem,1.1rem+3vw,3.6rem)] leading-[1.1] font-semibold">
      {t.cooperation.lead}
    </p>
    <p class="text-ink/85 mt-8 max-w-[62ch] lg:ml-[33.333%]">{t.cooperation.text}</p>
  </div>
</section>
