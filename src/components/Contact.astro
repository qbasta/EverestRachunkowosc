---
import { site } from '../config/site';
import { pagePath } from '../i18n';
import MapConsent from './MapConsent.astro';
import Contours from './Contours.astro';
import type { Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="section-y bg-night relative isolate overflow-hidden text-white"
>
  <Contours
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full text-[#9db8e6]"
    style="opacity:.55"
    cx={1180}
    cy={120}
    rings={12}
    r0={30}
    dr={44}
    rot={12}
  />
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-x-16">
    <div class="lg:col-span-5">
      <h2 id="contact-title" class="text-h2">
        {t.contact.title}
      </h2>
      <p class="mt-5 max-w-[40ch] text-white/80">{t.contact.intro}</p>

      <dl class="mt-10 space-y-6">
        <div>
          <dt class="text-sm text-white/60">{t.footer.phone}</dt>
          <dd class="mt-1 text-xl font-medium">
            <a href={`tel:${site.phoneHref}`} class="underline-offset-4 hover:underline">
              {site.phone}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-white/60">{t.footer.email}</dt>
          <dd class="mt-1 text-xl font-medium break-all">
            <a href={`mailto:${site.email}`} class="underline-offset-4 hover:underline">
              {site.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-white/60">{t.footer.address}</dt>
          <dd class="mt-1 text-xl font-medium">
            <address class="not-italic">
              {site.address.street}
              <br />
              {`${site.address.postalCode} ${site.address.city}`}
            </address>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-white/60">{t.contact.hours.title}</dt>
          <dd class="mt-1 text-lg font-medium sm:text-xl">
            <ul class="sm:max-w-sm">
              {t.contact.hours.rows.map((row) => (
                <li class="grid grid-cols-[1fr_auto] gap-x-4">
                  <span>{row.days}</span>
                  <span class="tabular-nums">{row.time}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <div class="mt-10 border-t border-white/20 pt-8">
        <p class="max-w-[40ch] text-white/80">{t.contact.quote.text}</p>
        <a href={pagePath('quote', lang)} class="btn btn-light mt-5">
          {t.contact.quote.cta}
        </a>
      </div>
    </div>

    <div class="lg:col-span-7">
      <MapConsent t={t} />
    </div>
  </div>
</section>
