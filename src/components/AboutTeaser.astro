---
import { Image } from 'astro:assets';
import { teamProfiles } from '../config/team';
import { aboutPath, type Lang } from '../i18n';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
  lang: Lang;
}
const { t, lang } = Astro.props;
// Na stronie głównej pokazujemy wybrane osoby; pełny zespół jest na podstronie „O nas”.
const featured = t.team.members.slice(0, 2);
---

<section
  id="about-teaser"
  aria-labelledby="about-teaser-title"
  class="section-y border-mist border-y bg-white"
>
  <div class="container-page grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <h2 id="about-teaser-title" class="text-summit text-h2">
        {t.aboutTeaser.title}
      </h2>
      <div class="mt-6 max-w-[52ch] space-y-4">
        <p class="text-ink text-xl leading-snug md:text-2xl">{t.aboutTeaser.paragraphs[0]}</p>
        <p class="text-slate">{t.aboutTeaser.paragraphs[1]}</p>
      </div>
      <a href={aboutPath(lang)} class="tlink mt-8 inline-block">
        {t.aboutTeaser.cta}
      </a>
    </div>

    <ul class="grid grid-cols-2 gap-5 lg:col-span-6">
      {featured.map((m) => (
        <li>
          <Image
            src={teamProfiles[m.key]?.photo!}
            alt={m.name}
            widths={[240, 360, 480]}
            sizes="(min-width: 1024px) 22vw, 44vw"
            class="aspect-[4/5] w-full rounded-[3px] object-cover object-top"
            loading="lazy"
          />
          <p class="text-ink mt-3 text-lg leading-tight font-semibold">{m.name}</p>
          <p class="text-glacier text-sm font-medium">{m.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
