---
import { Image } from 'astro:assets';
import LinkedInIcon from './LinkedInIcon.astro';
import Contours from './Contours.astro';
import { teamProfiles } from '../config/team';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

/** Inicjały do ramki osoby bez zdjęcia („Marek Kropiewnicki” → „MK”). */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<!-- Tytuł strony („Nasz zespół”) jest już w nagłówku nad sekcją – tutaj go nie powtarzamy. -->
<section id="team" aria-label={t.team.title} class="section-y border-mist border-t bg-white">
  <div class="container-page">
    <div class="team-list">
      {t.team.members.map((m) => {
        const profile = teamProfiles[m.key] ?? {};
        return (
          <article class="team-member">
            {/* Każda osoba ma tę samą ramkę 4:5 – ze zdjęciem albo z inicjałami – więc układ jest równy. */}
            {profile.photo ? (
              <Image
                src={profile.photo}
                alt={m.name}
                widths={[240, 360, 480, 720]}
                sizes="(min-width: 768px) 18rem, 92vw"
                class="team-portrait object-cover object-top"
                loading="lazy"
              />
            ) : (
              <div class="team-portrait team-monogram" aria-hidden="true">
                <Contours
                  class="text-summit absolute inset-0 h-full w-full opacity-70"
                  cx={720}
                  cy={470}
                  rings={9}
                  r0={60}
                  dr={95}
                  rot={-14}
                />
                <span class="font-display relative">{initials(m.name)}</span>
              </div>
            )}

            <div class="min-w-0">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class="text-ink font-display text-[1.75rem] leading-tight font-semibold md:text-[2rem]">
                    {m.name}
                  </h2>
                  <p class="text-glacier mt-1.5 text-lg font-medium">{m.role}</p>
                </div>
                {profile.linkedin && (
                  <a
                    href={profile.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.team.linkedin}: ${m.name}`}
                    class="text-glacier border-mist hover:bg-glacier inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] transition-colors hover:border-transparent hover:text-white"
                  >
                    <LinkedInIcon size={20} />
                  </a>
                )}
              </div>

              <div class="bio text-ink/85 mt-6 max-w-[68ch] space-y-4 leading-relaxed">
                {m.description.map((block) =>
                  typeof block === 'string' ? (
                    <p>{block}</p>
                  ) : (
                    <ul class="list-disc space-y-1.5 pl-5">
                      {block.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ),
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .team-member {
    display: grid;
    gap: 1.75rem;
    padding-block: 3rem;
    border-top: 1px solid var(--color-mist);
  }
  .team-member:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .team-member:last-child {
    padding-bottom: 0;
  }
  .team-portrait {
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 18rem;
    border-radius: 3px;
  }
  .team-monogram {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top: 3px solid var(--color-summit);
    background: var(--color-ice);
    color: var(--color-summit);
    font-size: 4.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  /* Telefon: osoba bez zdjęcia dostaje mały znak z inicjałami zamiast pustej ramki na pół ekranu. */
  @media (max-width: 47.99rem) {
    .team-monogram {
      aspect-ratio: 1;
      max-width: 6.5rem;
      font-size: 2.25rem;
    }
  }
  @media (min-width: 48rem) {
    .team-member {
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
      padding-block: 4rem;
    }
  }
  @media (min-width: 64rem) {
    .team-member {
      gap: 5rem;
    }
  }
</style>
