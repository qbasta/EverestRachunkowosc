---
import { Image } from 'astro:assets';
import LinkedInIcon from './LinkedInIcon.astro';
import { teamProfiles } from '../config/team';
import type { Dict } from '../i18n/pl';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<section id="team" aria-labelledby="team-title" class="section-y border-mist border-t bg-white">
  <div class="container-page">
    <h2 id="team-title" class="text-summit text-h2">
      {t.team.title}
    </h2>

    <!-- auto-fit: przy kolejnych osobach karty same przechodzą do 3–4 kolumn -->
    <div
      class="mt-14 grid items-start gap-x-10 gap-y-14"
      style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));"
    >
      {t.team.members.map((m) => {
        const profile = teamProfiles[m.key];
        return (
          <article class="flex flex-col">
            {profile?.photo ? (
              <Image
                src={profile.photo}
                alt={m.name}
                widths={[360, 540, 720]}
                sizes="(min-width: 768px) 45vw, 92vw"
                class="aspect-[4/5] w-full max-w-md rounded-[3px] object-cover object-top"
                loading="lazy"
              />
            ) : (
              <div
                class="text-glacier flex aspect-[4/5] w-full max-w-md items-center justify-center rounded-[3px] bg-ice text-6xl font-bold"
                aria-hidden="true"
              >
                {initials(m.name)}
              </div>
            )}

            <div class="mt-6 flex max-w-md items-start justify-between gap-4">
              <div>
                <h3 class="text-ink text-3xl font-semibold">{m.name}</h3>
                <p class="text-glacier mt-1 text-lg font-medium">{m.role}</p>
              </div>
              {profile?.linkedin && (
                <a
                  href={profile.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.team.linkedin}: ${m.name}`}
                  class="text-glacier border-mist hover:bg-glacier inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] transition-colors hover:border-transparent hover:text-white"
                >
                  <LinkedInIcon size={20} />
                </a>
              )}
            </div>

            <details class="group mt-4 max-w-md">
              <summary class="text-glacier cursor-pointer list-none text-base font-semibold underline underline-offset-4">
                <span class="group-open:hidden">{t.team.more}</span>
                <span class="hidden group-open:inline">{t.team.less}</span>
              </summary>
              <div class="bio text-slate mt-4 space-y-4 text-base leading-relaxed">
                {m.description.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </details>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Justowanie z dzieleniem wyrazów (język strony ustawia atrybut lang na <html>).
     Na wąskich ekranach zostaje wyrównanie do lewej – justowanie w wąskiej kolumnie daje „dziury”. */
  @media (min-width: 640px) {
    .bio p {
      text-align: justify;
      hyphens: auto;
      -webkit-hyphens: auto;
    }
  }
</style>
